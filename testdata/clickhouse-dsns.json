    {
      "id": "explicit-verified-ca",
      "dsn": "https://user:synthetic-secret@localhost/db?verify=true&ca_cert=%2Ffixture%2Froot%20ca.pem",
      "expected": {
        "host": "localhost",
        "port": 443,
        "username": "user",
        "password": "synthetic-secret",
        "database": "db",
        "secure": true,
        "ca_cert": "/fixture/root ca.pem",
        "connect_timeout": 10.0,
        "send_receive_timeout": 15.0
      }
    },
    {
