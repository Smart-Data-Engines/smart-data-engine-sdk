{
  "protocol": 1,
  "scope": "portable ClickHouse connection intent; synthetic credentials; not placement-format vectors",
  "cases": [
    {
      "id": "clickhouse-default",
      "dsn": "clickhouse://user:synthetic-secret@localhost/db",
      "expected": {
        "host": "localhost",
        "port": 8123,
        "username": "user",
        "password": "synthetic-secret",
        "database": "db",
        "secure": false,
        "ca_cert": null,
        "connect_timeout": 10.0,
        "send_receive_timeout": 15.0
      }
    },
    {
      "id": "clickhouses-default",
      "dsn": "clickhouses://user:synthetic-secret@localhost/db",
      "expected": {
        "host": "localhost",
        "port": 8443,
        "username": "user",
        "password": "synthetic-secret",
        "database": "db",
        "secure": true,
        "ca_cert": null,
        "connect_timeout": 10.0,
        "send_receive_timeout": 15.0
      }
    },
    {
